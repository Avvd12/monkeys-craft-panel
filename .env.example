# =========================================================
# Monkey's Craft Panel - variaveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# O .env nunca deve ser enviado ao Git.
# =========================================================

# --- Obrigatorias ---

# Segredo usado para assinar o cookie de sessao.
# Minimo de 20 caracteres. Gere um valor aleatorio e unico.
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Token do bot de Discord.
# Obtido em https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# --- Portas ---

# Porta da API interna (usada pelo painel e pelo bot)
PORTA_INTERNA=3001

# Porta publica do painel web
PORTA_PUBLICA=3000

# --- Observacao ---
# As credenciais do RCON do Minecraft e os IDs de canais do Discord
# ficam no config.json, nao aqui.