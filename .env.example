# ==============================================================================
# MONKEY'S CRAFT CONTROL PANEL - VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha com as credenciais reais do seu ambiente.
# ==============================================================================

# Portas de Execução do Painel
PORT=3000
PORTA_PUBLICA=3000
PORTA_INTERNA=3001

# Segredo de Sessão (Express Session / Cookie - recomendado 64 hexadecimais)
SESSION_SECRET=coloque_aqui_um_segredo_criptografico_de_64_caracteres_hexadecimais

# Credenciais e Conexão RCON do Servidor Minecraft
RCON_HOST=localhost
RCON_PORT=25575
RCON_PASSWORD=sua_senha_rcon_aqui

# Caminhos de Diretórios no Sistema de Arquivos
MC_SERVER_DIR=D:/SERVIDOR/Servidor
BOT_DIR=D:/SERVIDOR/Site/discord-bot

# Integração com Bot Discord (Opcional caso execute bot integrado)
DISCORD_TOKEN=seu_discord_bot_token_aqui
CLIENT_ID=seu_client_id_aqui
GUILD_ID=seu_guild_id_aqui

# Flags e Recursos
ENABLE_VIEWER_ROLE=false
